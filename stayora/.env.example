SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-publishable-or-anon-key

# Generate a unique value with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-value

# Optional integrations. Rotate credentials that were previously shared.
GEMINI_API_KEY=
GOOGLE_MAPS_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Server-only key required for Supabase Storage uploads. Never expose it to clients.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=stayora-images

# Use a shared Redis-compatible store in production across multiple workers.
RATELIMIT_STORAGE_URI=memory://